{
  "name": "magic-siege-skill5",
  "private": true,
  "version": "0.7.8",
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node scripts/run-unit-tests.mjs",
    "test:balance": "node tests/score-balance.bench.mjs",
    "test:browser": "playwright test",
    "start": "node server/index.mjs",
    "start:server": "node server/index.mjs",
    "start:design": "node server/index.mjs --design=current",
    "test:design": "node --test tests/current-design.test.js tests/current-design-contract.test.js tests/current-design-effects.test.js",
    "start:client": "electron client/desktop/main.mjs",
    "package:client": "npm run build && node scripts/package-desktop.mjs",
    "package:server": "node scripts/package-release.mjs server",
    "start:browser": "node client/launcher.mjs",
    "package:browser": "npm run build && node scripts/package-release.mjs client",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "setup:desktop": "node node_modules/electron/install.js",
    "package:repository": "node scripts/prepare-repository-client.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.64.1",
    "electron": "45.1.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "type": "module"
}
